# MediFlow AI frontend. The default is safe for local demonstrations.
VITE_DATA_SOURCE=mock

# Required only when VITE_DATA_SOURCE=n8n. This is a public URL, not a secret.
VITE_N8N_BASE_URL=

# Optional request timeout in milliseconds.
VITE_N8N_TIMEOUT_MS=8000

# Optional JSON object to override individual conceptual routes.
# Example: {"registerPatient":"/webhook/custom/patients","receiveExternalTriage":"/webhook/custom/triage/:episodeId"}
VITE_N8N_ROUTES_JSON=

# Do not put API keys, webhook secrets, bearer tokens, or private credentials
# in VITE_* variables. Vite exposes them to the browser.